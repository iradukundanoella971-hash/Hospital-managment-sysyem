<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.hospitalmanagementsystem.controller.HomeController"
            stylesheets="@../css/style.css"
            styleClass="root-pane">

    <!-- TOP: Header -->
    <top>
        <VBox styleClass="header" alignment="CENTER">
            <padding><Insets top="30" bottom="20"/></padding>
            <Label text="🏥" styleClass="hospital-icon"/>
            <Label text="Hospital Management System" styleClass="hospital-title"/>
            <Label text="Providing Quality Healthcare Management" styleClass="hospital-subtitle"/>
        </VBox>
    </top>

    <!-- CENTER: Welcome + Role Buttons -->
    <center>
        <VBox alignment="CENTER" spacing="30">
            <padding><Insets top="20" bottom="40" left="60" right="60"/></padding>

            <!-- About card -->
            <VBox styleClass="about-card" alignment="CENTER" spacing="8">
                <Label text="Welcome to Our Hospital System" styleClass="section-title"/>
                <Label text="A complete digital solution for managing doctors, patients, and appointments."
                       styleClass="section-text" wrapText="true" textAlignment="CENTER"/>
                <Label text="Please select your role to continue." styleClass="section-text"/>
            </VBox>

            <!-- Role cards -->
            <HBox alignment="CENTER" spacing="20">

                <VBox styleClass="role-card" alignment="CENTER" spacing="10">
                    <Label text="🔑" styleClass="role-icon"/>
                    <Label text="Admin" styleClass="role-label"/>
                    <Label text="Hospital Manager" styleClass="role-desc"/>
                    <Button fx:id="adminBtn" text="Admin Login" styleClass="btn-admin"
                            onAction="#handleAdminLogin"/>
                </VBox>

                <VBox styleClass="role-card" alignment="CENTER" spacing="10">
                    <Label text="👨‍⚕️" styleClass="role-icon"/>
                    <Label text="Doctor" styleClass="role-label"/>
                    <Label text="Medical Staff" styleClass="role-desc"/>
                    <Button fx:id="doctorBtn" text="Doctor Login" styleClass="btn-doctor"
                            onAction="#handleDoctorLogin"/>
                </VBox>

                <VBox styleClass="role-card" alignment="CENTER" spacing="10">
                    <Label text="🧑" styleClass="role-icon"/>
                    <Label text="Patient" styleClass="role-label"/>
                    <Label text="Registered Patient" styleClass="role-desc"/>
                    <Button fx:id="patientBtn" text="Patient Login" styleClass="btn-patient"
                            onAction="#handlePatientLogin"/>
                    <Button fx:id="signupBtn" text="Sign Up" styleClass="btn-signup"
                            onAction="#handleSignup"/>
                </VBox>

            </HBox>
        </VBox>
    </center>

    <!-- BOTTOM: Footer -->
    <bottom>
        <HBox alignment="CENTER" styleClass="footer">
            <padding><Insets top="15" bottom="15"/></padding>
            <Label text="© 2024 Hospital Management System  |  All Rights Reserved"
                   styleClass="footer-text"/>
        </HBox>
    </bottom>

</BorderPane>
