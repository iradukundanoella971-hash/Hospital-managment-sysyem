<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.hospitalmanagmentsystem.controller.DoctorDashboardController"
            styleClass="root-pane">
    <top>
        <HBox spacing="10" styleClass="topbar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label fx:id="doctorLabel" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Today's Patients"/>
            <TableView fx:id="todayTable" prefHeight="220">
                <columns>
                    <TableColumn text="Patient" fx:id="patientCol"/>
                    <TableColumn text="Date" fx:id="dateCol"/>
                    <TableColumn text="Time" fx:id="timeCol"/>
                </columns>
            </TableView>
            <TitledPane text="Medical Record + Prescription" expanded="true">
                <GridPane hgap="10" vgap="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Patient ID" GridPane.rowIndex="0"/>
                    <TextField fx:id="patientIdField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Illness Description / Diagnosis" GridPane.rowIndex="1"/>
                    <TextArea fx:id="diagnosisArea" GridPane.columnIndex="1" GridPane.rowIndex="1" prefRowCount="3"/>
                    <Label text="Medicine" GridPane.rowIndex="2"/>
                    <TextField fx:id="medicineField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Button text="Save Record" onAction="#handleAddRecord" styleClass="btn-primary"
                            GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
            </TitledPane>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Follow-up Date"/>
                <DatePicker fx:id="followUpDate"/>
                <Button text="Schedule Follow-up" onAction="#handleScheduleFollowUp" styleClass="btn-secondary"/>
            </HBox>
            <Label fx:id="feedbackLabel" styleClass="feedback"/>
        </VBox>
    </center>
</BorderPane>
