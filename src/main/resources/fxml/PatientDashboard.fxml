<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.hospitalmanagmentsystem.controller.PatientDashboardController"
            styleClass="root-pane">
    <top>
        <HBox spacing="10" styleClass="topbar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label fx:id="patientLabel" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Login" onAction="#handleGoLogin" styleClass="btn-secondary"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger"/>
        </HBox>
    </top>
    <center>
        <TabPane>
            <tabs>
                <Tab text="Book Appointment" closable="false">
                    <VBox spacing="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <ComboBox fx:id="doctorCombo" promptText="Select doctor"/>
                        <DatePicker fx:id="datePicker"/>
                        <ComboBox fx:id="timeCombo" promptText="Time"/>
                        <Button text="Book" onAction="#handleBook" styleClass="btn-primary"/>
                        <Label fx:id="bookingFeedback" styleClass="feedback"/>
                    </VBox>
                </Tab>
                <Tab text="My Appointments" closable="false">
                    <VBox spacing="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <TableView fx:id="appointmentsTable">
                            <columns>
                                <TableColumn text="Doctor" fx:id="apDoctorCol"/>
                                <TableColumn text="Date" fx:id="apDateCol"/>
                                <TableColumn text="Time" fx:id="apTimeCol"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Medical History" closable="false">
                    <VBox spacing="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <ListView fx:id="recordsList"/>
                    </VBox>
                </Tab>
                <Tab text="Register" closable="false">
                    <GridPane hgap="10" vgap="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <Label text="Full Name" GridPane.rowIndex="0"/>
                        <TextField fx:id="regNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Age" GridPane.rowIndex="1"/>
                        <TextField fx:id="regAgeField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Location" GridPane.rowIndex="2"/>
                        <TextField fx:id="regLocationField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Phone" GridPane.rowIndex="3"/>
                        <TextField fx:id="regPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="Sex" GridPane.rowIndex="4"/>
                        <ComboBox fx:id="regSexCombo" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="Username" GridPane.rowIndex="5"/>
                        <TextField fx:id="regUserField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        <Label text="Password" GridPane.rowIndex="6"/>
                        <PasswordField fx:id="regPassField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        <Button text="Register" onAction="#handleRegister" styleClass="btn-primary"
                                GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        <Label fx:id="registerFeedback" GridPane.columnIndex="1" GridPane.rowIndex="8" styleClass="feedback"/>
                    </GridPane>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
