<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.hospitalmanagmentsystem.controller.PatientDashboardController"
            styleClass="root-pane">
    <top>
        <HBox spacing="10" styleClass="topbar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label fx:id="patientLabel" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Login" onAction="#handleGoLogin" styleClass="btn-secondary"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger"/>
        </HBox>
    </top>
    <center>
        <TabPane>
            <tabs>
                <Tab text="Book Appointment" closable="false">
                    <VBox spacing="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <ComboBox fx:id="doctorCombo" promptText="Select doctor"/>
                        <DatePicker fx:id="datePicker"/>
                        <ComboBox fx:id="timeCombo" promptText="Time"/>
                        <Button text="Book" onAction="#handleBook" styleClass="btn-primary"/>
                        <Label fx:id="bookingFeedback" styleClass="feedback"/>
                    </VBox>
                </Tab>
                <Tab text="My Appointments" closable="false">
                    <VBox spacing="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <TableView fx:id="appointmentsTable">
                            <columns>
                                <TableColumn text="Doctor" fx:id="apDoctorCol"/>
                                <TableColumn text="Date" fx:id="apDateCol"/>
                                <TableColumn text="Time" fx:id="apTimeCol"/>
                            </columns>
                        </TableView>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Cancel Selected" onAction="#handleCancelSelected" styleClass="btn-danger"/>
                            <Label text="Reschedule:"/>
                            <DatePicker fx:id="rescheduleDatePicker"/>
                            <ComboBox fx:id="rescheduleTimeCombo" promptText="Time"/>
                            <Button text="Apply" onAction="#handleRescheduleSelected" styleClass="btn-secondary"/>
                        </HBox>
                    </VBox>
                </Tab>
                <Tab text="Medical History" closable="false">
                    <VBox spacing="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                        <ListView fx:id="recordsList"/>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
