<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.hospitalmanagmentsystem.controller.AdminDashboardController"
            styleClass="root-pane">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="Admin Dashboard" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="btn-danger"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label fx:id="summaryLabel" styleClass="feedback"/>
            <TabPane VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Manage Users" closable="false">
                        <VBox spacing="12">
                            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                            <Accordion>
                                <panes>
                                    <TitledPane text="Create Doctor Account" expanded="true">
                                        <GridPane hgap="10" vgap="10">
                                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                            <Label text="Name" GridPane.rowIndex="0"/>
                                            <TextField fx:id="doctorNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                            <Label text="Age" GridPane.rowIndex="1"/>
                                            <TextField fx:id="doctorAgeField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                            <Label text="Specialization" GridPane.rowIndex="2"/>
                                            <TextField fx:id="doctorSpecField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                            <Label text="Username" GridPane.rowIndex="3"/>
                                            <TextField fx:id="doctorUserField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                            <Label text="Password" GridPane.rowIndex="4"/>
                                            <PasswordField fx:id="doctorPassField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                            <Button text="Add Doctor" onAction="#handleAddDoctor" styleClass="btn-primary"
                                                    GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                                        </GridPane>
                                    </TitledPane>
                                    <TitledPane text="Create Patient Account" expanded="false">
                                        <GridPane hgap="10" vgap="10">
                                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                            <Label text="Name" GridPane.rowIndex="0"/>
                                            <TextField fx:id="patientNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                            <Label text="Age" GridPane.rowIndex="1"/>
                                            <TextField fx:id="patientAgeField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                            <Label text="Location" GridPane.rowIndex="2"/>
                                            <TextField fx:id="patientLocationField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                            <Label text="Phone" GridPane.rowIndex="3"/>
                                            <TextField fx:id="patientPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                            <Label text="Sex" GridPane.rowIndex="4"/>
                                            <ComboBox fx:id="patientSexCombo" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                            <Label text="Username" GridPane.rowIndex="5"/>
                                            <TextField fx:id="patientUserField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                                            <Label text="Password" GridPane.rowIndex="6"/>
                                            <PasswordField fx:id="patientPassField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                                            <Button text="Add Patient" onAction="#handleAddPatient" styleClass="btn-primary"
                                                    GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                                        </GridPane>
                                    </TitledPane>
                                    <TitledPane text="Create Admin Account" expanded="false">
                                        <GridPane hgap="10" vgap="10">
                                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                            <Label text="Username" GridPane.rowIndex="0"/>
                                            <TextField fx:id="adminUserField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                            <Label text="Password" GridPane.rowIndex="1"/>
                                            <PasswordField fx:id="adminPassField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                            <Button text="Add Admin" onAction="#handleAddAdmin" styleClass="btn-primary"
                                                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                        </GridPane>
                                    </TitledPane>
                                </panes>
                            </Accordion>
                            <SplitPane dividerPositions="0.34,0.68" VBox.vgrow="ALWAYS">
                                <VBox spacing="8">
                                    <Label text="Doctors"/>
                                    <TableView fx:id="doctorsTable" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn text="ID" fx:id="doctorIdCol"/>
                                            <TableColumn text="Name" fx:id="doctorNameCol"/>
                                            <TableColumn text="Specialization" fx:id="doctorSpecCol"/>
                                        </columns>
                                    </TableView>
                                    <Button text="Remove Selected Doctor" onAction="#handleRemoveDoctor" styleClass="btn-danger"/>
                                </VBox>
                                <VBox spacing="8">
                                    <Label text="Patients"/>
                                    <TableView fx:id="patientsTable" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn text="ID" fx:id="patientIdCol"/>
                                            <TableColumn text="Name" fx:id="patientNameCol"/>
                                        </columns>
                                    </TableView>
                                    <Button text="Remove Selected Patient" onAction="#handleRemovePatient" styleClass="btn-danger"/>
                                </VBox>
                                <VBox spacing="8">
                                    <Label text="All Accounts"/>
                                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn text="Username" fx:id="userNameCol"/>
                                            <TableColumn text="Role" fx:id="userRoleCol"/>
                                            <TableColumn text="Linked ID" fx:id="userLinkedCol"/>
                                            <TableColumn text="Active" fx:id="userActiveCol"/>
                                        </columns>
                                    </TableView>
                                    <Button text="Deactivate User" onAction="#handleDeactivateUser" styleClass="btn-secondary"/>
                                </VBox>
                            </SplitPane>
                        </VBox>
                    </Tab>
                    <Tab text="Monitor Appointments" closable="false">
                        <VBox spacing="10">
                            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Doctor"/>
                                <ComboBox fx:id="filterDoctorCombo" promptText="All doctors"/>
                                <Label text="Date"/>
                                <DatePicker fx:id="filterDatePicker"/>
                                <Label text="Status"/>
                                <ComboBox fx:id="filterStatusCombo" promptText="Status"/>
                                <Button text="Apply Filter" onAction="#handleApplyAppointmentFilter" styleClass="btn-secondary"/>
                                <Button text="Clear" onAction="#handleClearAppointmentFilter" styleClass="btn-secondary"/>
                            </HBox>
                            <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn text="ID" fx:id="apIdCol"/>
                                    <TableColumn text="Doctor" fx:id="apDoctorCol"/>
                                    <TableColumn text="Patient" fx:id="apPatientCol"/>
                                    <TableColumn text="Date" fx:id="apDateCol"/>
                                    <TableColumn text="Time" fx:id="apTimeCol"/>
                                    <TableColumn text="Status" fx:id="apStatusCol"/>
                                </columns>
                            </TableView>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button text="Cancel Selected" onAction="#handleCancelAppointment" styleClass="btn-danger"/>
                                <Label text="Reschedule to"/>
                                <DatePicker fx:id="rescheduleDatePicker"/>
                                <ComboBox fx:id="rescheduleTimeCombo" promptText="Time"/>
                                <Button text="Reschedule" onAction="#handleRescheduleAppointment" styleClass="btn-secondary"/>
                            </HBox>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
