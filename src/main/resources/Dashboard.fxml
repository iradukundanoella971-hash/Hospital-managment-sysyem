<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.hospitalmanagmentsystem.controller.DashboardController">

    <Label text="Dashboard" styleClass="section-title">
        <font><Font size="20"/></font>
    </Label>

    <!-- Stats Cards -->
    <HBox spacing="20" alignment="CENTER">
        <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
            <Label text="👨‍⚕️" style="-fx-font-size: 40px;"/>
            <Label fx:id="doctorCount" text="0" styleClass="stat-number"/>
            <Label text="Total Doctors" styleClass="stat-label"/>
        </VBox>

        <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
            <Label text="👤" style="-fx-font-size: 40px;"/>
            <Label fx:id="patientCount" text="0" styleClass="stat-number"/>
            <Label text="Total Patients" styleClass="stat-label"/>
        </VBox>

        <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
            <Label text="📅" style="-fx-font-size: 40px;"/>
            <Label fx:id="appointmentCount" text="0" styleClass="stat-number"/>
            <Label text="Today's Appointments" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- Welcome Message -->
    <VBox spacing="10" styleClass="welcome-card">
        <Label text="Welcome to HMS!" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Manage doctors, patients, appointments, and medical records efficiently."
               wrapText="true"/>
    </VBox>

    <!-- Quick Actions -->
    <VBox spacing="10">
        <Label text="Quick Actions" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <HBox spacing="15">
            <Button text="➕ Add Doctor" styleClass="action-button" onAction="#quickAddDoctor"/>
            <Button text="➕ Add Patient" styleClass="action-button" onAction="#quickAddPatient"/>
            <Button text="📅 Book Appointment" styleClass="action-button" onAction="#quickBookAppointment"/>
        </HBox>
    </VBox>
</VBox>