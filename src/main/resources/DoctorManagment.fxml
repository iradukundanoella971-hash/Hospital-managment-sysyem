<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.hospitalmanagmentsystem.controller.DoctorController">

    <Label text="👨‍⚕️ Doctor Management" styleClass="section-title">
        <font><Font size="20"/></font>
    </Label>

    <!-- Add Doctor Form -->
    <TitledPane text="➕ Add New Doctor" animated="false" expanded="false">
        <GridPane hgap="15" vgap="10" padding="15">
            <Label text="Doctor ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="doctorIdField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="D001"/>

            <Label text="Full Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="doctorNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Dr. John Smith"/>

            <Label text="Age:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="doctorAgeField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="35"/>

            <Label text="Specialization:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="specializationCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <PasswordField fx:id="doctorPasswordField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Button text="Register Doctor" styleClass="action-button"
                    onAction="#handleAddDoctor" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label fx:id="doctorStatusLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>
    </TitledPane>

    <!-- Search Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="🔍 Search:"/>
        <TextField fx:id="searchField" promptText="Search by name or specialization" HBox.hgrow="ALWAYS"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Clear" onAction="#handleClearSearch"/>
    </HBox>

    <!-- Doctors Table -->
    <TableView fx:id="doctorsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" fx:id="colId" prefWidth="80"/>
            <TableColumn text="Name" fx:id="colName" prefWidth="200"/>
            <TableColumn text="Age" fx:id="colAge" prefWidth="60"/>
            <TableColumn text="Specialization" fx:id="colSpecialization" prefWidth="150"/>
        </columns>
    </TableView>

    <Label fx:id="globalStatusLabel" styleClass="status-label"/>
</VBox>